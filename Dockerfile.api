FROM python:3.14.1-slim-bookworm AS builder

ENV UV_LINK_MODE=copy
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /uvx /bin/
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.14.1-slim-bookworm AS runtime

ARG BUILD_SHA=unknown
ARG RELEASE_VERSION=0.2.0
LABEL org.opencontainers.image.revision="${BUILD_SHA}" \
      org.opencontainers.image.version="${RELEASE_VERSION}"

RUN groupadd --system polygraphml && useradd --system --gid polygraphml --home /app polygraphml \
    && mkdir /data && chown polygraphml:polygraphml /data
WORKDIR /app
COPY --from=builder --chown=polygraphml:polygraphml /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:${PATH}" PYTHONUNBUFFERED=1 \
    POLYGRAPHML_DATABASE_PATH=/data/polygraphml.db \
    POLYGRAPHML_ARTIFACT_ROOT=/data/artifacts
USER polygraphml
EXPOSE 8000
CMD ["uvicorn", "polygraphml.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
