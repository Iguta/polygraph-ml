            "type": "integer"
          }
        },
        "required": [
          "project_id",
          "scenario_revision",
          "mode"
        ],
        "title": "StartAuditRequest",
        "type": "object"
      },
      "UploadArtifactInput": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "pattern": "^[A-Za-z0-9_-]{1,64}$",
            "title": "Client Id",
            "type": "string"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ArtifactKind"
          },
          "media_type": {
            "title": "Media Type",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes",
            "type": "integer"
          }
        },
        "required": [
          "client_id",
          "filename",
          "kind",
          "size_bytes",
          "sha256",
          "media_type"
        ],
        "title": "UploadArtifactInput",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
