        ],
        "title": "ReportedMetricSource",
        "type": "object"
      },
      "ScenarioRequest": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "decision_time": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Decision Time",
            "type": "string"
          },
          "intended_metric": {
            "enum": [
              "roc_auc",
              "accuracy",
              "f1"
            ],
            "title": "Intended Metric",
            "type": "string"
          },
          "notes": {
            "default": "",
            "maxLength": 2000,
            "title": "Notes",
            "type": "string"
          },
          "positive_label": {
            "default": "1",
            "title": "Positive Label",
            "type": "string"
          },
          "prediction_horizon": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Prediction Horizon",
            "type": "string"
          },
          "revision": {
            "default": 1,
            "title": "Revision",
            "type": "integer"
          },
          "row_entity": {
            "maxLength": 300,
            "minLength": 2,
            "title": "Row Entity",
            "type": "string"
          },
          "split_unit": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Split Unit",
            "type": "string"
          },
          "target_definition": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Target Definition",
            "type": "string"
