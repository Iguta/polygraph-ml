        "required": [
          "target_definition",
          "row_entity",
          "decision_time",
          "prediction_horizon",
          "split_unit",
          "intended_metric"
        ],
        "title": "ScenarioRequest",
        "type": "object"
      },
      "SourceInput": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "default": "main",
            "title": "Ref",
            "type": "string"
          },
          "repository_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Repository Url"
          },
          "type": {
