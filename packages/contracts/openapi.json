{
  "components": {
    "schemas": {
      "AnswerRequest": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Answer",
            "type": "string"
          },
          "question_id": {
            "title": "Question Id",
            "type": "string"
          },
          "scenario_patch": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Patch"
          }
        },
        "required": [
          "question_id",
          "answer"
        ],
        "title": "AnswerRequest",
        "type": "object"
      },
      "ArtifactKind": {
        "enum": [
          "dataset",
          "model",
          "notebook",
          "source",
          "manifest"
        ],
        "title": "ArtifactKind",
        "type": "string"
      },
      "AuditMode": {
        "enum": [
          "complete_audit",
          "dataset_preflight"
        ],
        "title": "AuditMode",
        "type": "string"
      },
      "BenchmarkProjectRequest": {
        "additionalProperties": false,
        "properties": {
          "benchmark_id": {
            "title": "Benchmark Id",
            "type": "string"
          }
        },
        "required": [
          "benchmark_id"
        ],
        "title": "BenchmarkProjectRequest",
        "type": "object"
      },
      "CompleteUploadsRequest": {
        "additionalProperties": false,
        "properties": {
          "artifact_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 12,
            "minItems": 1,
            "title": "Artifact Ids",
            "type": "array"
          }
        },
        "required": [
          "artifact_ids"
        ],
        "title": "CompleteUploadsRequest",
        "type": "object"
      },
      "CreateProjectRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/SourceInput"
          }
        },
        "required": [
          "name",
          "source"
        ],
        "title": "CreateProjectRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MappingRequest": {
        "additionalProperties": false,
        "properties": {
          "dataset_artifact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset Artifact Id"
          },
          "entity_column": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entity Column"
          },
          "model_artifact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Artifact Id"
          },
          "notebook_artifact_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
